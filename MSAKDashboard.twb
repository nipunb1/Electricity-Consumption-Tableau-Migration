<?xml version="1.0" ?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" source-build="20231.23.0213.1530" source-platform="win" version="18.1">
  <document-format-change-manifest>
    <IntuitiveSorting UAC="false"/>
    <IntuitiveSorting_SP2 UAC="false"/>
    <SheetIdentifierTracking UAC="false"/>
    <WindowsPersistSimpleIdentifiers UAC="false"/>
  </document-format-change-manifest>
  <preferences/>
  <datasources>
    <datasource caption="ICG_2025" inline="true" name="federated.0123456789abcdef" version="18.1">
      <connection class="excel-direct" cleaning="no" compat="no" dataRefreshTime="" filename="Data/ICG_2025.xlsx" interpretationMode="0" password="" server="" validate="no">
        <relation connection="excel-direct" name="Data" table="[Data$]" type="table"/>
      </connection>
      <aliases enabled="yes"/>
      <column name="[Date]" caption="Date" datatype="date" role="dimension" type="ordinal"/>
      <column name="[Region]" caption="Region" datatype="string" role="dimension" type="nominal"/>
      <column name="[Product_Category]" caption="Product_Category" datatype="string" role="dimension" type="nominal"/>
      <column name="[Sales_Channel]" caption="Sales_Channel" datatype="string" role="dimension" type="nominal"/>
      <column name="[Customer_Segment]" caption="Customer_Segment" datatype="string" role="dimension" type="nominal"/>
      <column name="[Revenue]" caption="Revenue" datatype="real" role="measure" type="quantitative"/>
      <column name="[Units_Sold]" caption="Units_Sold" datatype="integer" role="measure" type="quantitative"/>
      <column name="[Cost]" caption="Cost" datatype="real" role="measure" type="quantitative"/>
      <column name="[Customer_ID]" caption="Customer_ID" datatype="string" role="dimension" type="nominal"/>
      <column name="[Product_ID]" caption="Product_ID" datatype="string" role="dimension" type="nominal"/>
      <column name="[Sales_Rep]" caption="Sales_Rep" datatype="string" role="dimension" type="nominal"/>
      <column name="[Quarter]" caption="Quarter" datatype="string" role="dimension" type="ordinal"/>
      <column name="[Year]" caption="Year" datatype="integer" role="dimension" type="ordinal"/>
      <column name="[Discount_Percent]" caption="Discount_Percent" datatype="real" role="measure" type="quantitative"/>
      <column name="[Profit_Margin]" caption="Profit_Margin" datatype="real" role="measure" type="quantitative"/>
      <column name="[Profit]" caption="Profit" datatype="real" role="measure" type="quantitative"/>
      <column name="[Unit_Price]" caption="Unit_Price" datatype="real" role="measure" type="quantitative"/>
      <column name="[Discounted_Revenue]" caption="Discounted_Revenue" datatype="real" role="measure" type="quantitative"/>
      <layout dim-ordering="alphabetic" dim-percentage="0.5" measure-ordering="alphabetic" measure-percentage="0.4" show-structure="true"/>
      <semantic-values>
        <semantic-value key="[Country].[Name]" value="&amp;quot;United States&amp;quot;"/>
      </semantic-values>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Revenue by Region">
      <table>
        <view>
          <datasources>
            <datasource caption="ICG_2025" name="federated.0123456789abcdef"/>
          </datasources>
          <datasource-dependencies datasource="federated.0123456789abcdef">
            <column name="[Region]" caption="Region" datatype="string" role="dimension" type="nominal"/>
            <column name="[Revenue]" caption="Revenue" datatype="real" role="measure" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
      </table>
    </worksheet>
    <worksheet name="Revenue Trend">
      <table>
        <view>
          <datasources>
            <datasource caption="ICG_2025" name="federated.0123456789abcdef"/>
          </datasources>
          <datasource-dependencies datasource="federated.0123456789abcdef">
            <column name="[Date]" caption="Date" datatype="date" role="dimension" type="ordinal"/>
            <column name="[Revenue]" caption="Revenue" datatype="real" role="measure" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
      </table>
    </worksheet>
    <worksheet name="Product Performance">
      <table>
        <view>
          <datasources>
            <datasource caption="ICG_2025" name="federated.0123456789abcdef"/>
          </datasources>
          <datasource-dependencies datasource="federated.0123456789abcdef">
            <column name="[Product_Category]" caption="Product_Category" datatype="string" role="dimension" type="nominal"/>
            <column name="[Revenue]" caption="Revenue" datatype="real" role="measure" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
      </table>
    </worksheet>
    <worksheet name="Sales Summary">
      <table>
        <view>
          <datasources>
            <datasource caption="ICG_2025" name="federated.0123456789abcdef"/>
          </datasources>
          <datasource-dependencies datasource="federated.0123456789abcdef">
            <column name="[Region]" caption="Region" datatype="string" role="dimension" type="nominal"/>
            <column name="[Product_Category]" caption="Product_Category" datatype="string" role="dimension" type="nominal"/>
            <column name="[Revenue]" caption="Revenue" datatype="real" role="measure" type="quantitative"/>
            <column name="[Units_Sold]" caption="Units_Sold" datatype="integer" role="measure" type="quantitative"/>
            <column name="[Profit]" caption="Profit" datatype="real" role="measure" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Main Dashboard">
      <size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200"/>
      <zones>
        <zone h="400" w="600" x="0" y="0" id="0">
          <zone-style/>
          <zone name="Revenue by Region"/>
        </zone>
        <zone h="400" w="600" x="600" y="0" id="1">
          <zone-style/>
          <zone name="Revenue Trend"/>
        </zone>
        <zone h="400" w="600" x="0" y="400" id="2">
          <zone-style/>
          <zone name="Product Performance"/>
        </zone>
        <zone h="400" w="600" x="600" y="400" id="3">
          <zone-style/>
          <zone name="Sales Summary"/>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>